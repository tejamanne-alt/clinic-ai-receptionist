# ─────────────────────────────────────────────────────────────────────────────
# Vaani environment template — copy to .env and fill in.
#
# I2 (§4 key custody): every key here is SERVER-ONLY unless explicitly marked
# public. Never copy a secret into a NEXT_PUBLIC_* variable — anything with
# that prefix is bundled into client JavaScript. The browser gets short-lived
# session tokens minted server-side, never raw provider keys.
# tests/env.test.ts enforces this rule against this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (server-only; Supabase pooler URL in prod, local PG in dev) ──
DATABASE_URL=

# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; bypasses RLS — voice tools use this
NEXT_PUBLIC_SUPABASE_URL=           # public by design (same value as SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # public by design; RLS enforces row access

# ── Speech providers (Phase 0 bake-off + SpeechProvider adapter) ──
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=te-IN-ShrutiNeural
GOOGLE_SPEECH_API_KEY=              # bake-off comparison only, not a runtime provider

# ── Voice orchestration (Phase 1) ──
VAPI_PRIVATE_KEY=                   # server-only; creates assistants, reads calls
VAPI_PUBLIC_KEY=                    # public by design — can only START calls from the browser
VAPI_ASSISTANT_ID=                  # printed by scripts/vapi/sync-assistant.ts
VAPI_WEBHOOK_SECRET=                # server-only; HMAC verification of Vapi webhooks
PUBLIC_BASE_URL=                    # https URL of this app (ngrok/vercel) for the webhook
DEMO_CLINIC_ID=00000000-0000-0000-0000-000000000001

# ── WhatsApp via MessagingProvider adapter (Phase 2) ──
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
MSG91_AUTH_KEY=

# ── Telephony SIP trunk (Phase 3) ──
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
