{
  "name": "vaani",
  "version": "0.1.0",
  "private": true,
  "description": "Telugu-first AI voice receptionist for Indian clinics",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bakeoff": "tsx scripts/bakeoff/run.ts",
    "bakeoff:tts": "tsx scripts/bakeoff/tts.ts",
    "db:setup": "bash scripts/db/setup-local.sh",
    "vapi:sync": "tsx scripts/vapi/sync-assistant.ts",
    "audit:keys": "bash scripts/audit/key-exposure.sh",
    "audit:latency": "tsx scripts/audit/latency-report.ts",
    "roi": "tsx scripts/roi-one-pager.ts",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@vapi-ai/web": "^2.6.1",
    "next": "^15.3.3",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
